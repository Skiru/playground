{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Obszary odkrywania{% endblock %}
{% block main %}<div class="row"><div class="col-lg-7"><table class="table"><thead><tr><th>Nazwa</th><th>Środek / promień</th><th>Limit</th><th>Włączony</th></tr></thead><tbody>{% for a in areas %}<tr><td>{{ a.name }}</td><td>{{ a.center_latitude }}, {{ a.center_longitude }} / {{ a.radius_km }} km</td><td>{{ a.maximum_candidates_per_run }}</td><td><form method="post" action="{{ path('admin_place_discovery_area_toggle',{id:a.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('area-'~a.id) }}"><button class="btn btn-sm {{ a.enabled ? 'btn-success':'btn-outline-secondary' }}">{{ a.enabled ? 'Tak':'Nie' }}</button></form></td></tr>{% endfor %}</tbody></table></div><div class="col-lg-5"><h3>Nowy bezpieczny obszar</h3><p>Obszar jest tworzony jako wyłączony. Maksymalny promień: 25 km.</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('discovery-area') }}"><label class="form-label">Nazwa</label><input required class="form-control mb-2" name="name" value="Rzeszów pilot"><label class="form-label">Kraj</label><input required class="form-control mb-2" name="country_code" value="PL"><label class="form-label">Szerokość</label><input required class="form-control mb-2" name="latitude" value="50.0413"><label class="form-label">Długość</label><input required class="form-control mb-2" name="longitude" value="21.9990"><label class="form-label">Promień km</label><input required class="form-control mb-2" name="radius_km" value="3"><label class="form-label">Minimalna pewność</label><input required class="form-control mb-2" name="minimum_confidence" value="0.8"><label class="form-label">Limit</label><input required class="form-control mb-2" name="maximum_candidates" value="20"><button class="btn btn-primary">Utwórz wyłączony obszar</button></form></div></div>{% endblock %}
