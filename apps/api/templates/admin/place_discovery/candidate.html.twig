{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}{{ candidate.name }}{% endblock %}
{% block main %}
<div class="row"><div class="col-lg-7"><dl class="row"><dt class="col-4">Status</dt><dd class="col-8">{{ candidate.status }}</dd><dt class="col-4">Źródło</dt><dd class="col-8">{{ candidate.source }} / {{ candidate.source_release }} / {{ candidate.external_id }}</dd><dt class="col-4">Adres</dt><dd class="col-8">{{ candidate.address_line1 }}, {{ candidate.postal_code }} {{ candidate.locality }}</dd><dt class="col-4">WWW / telefon</dt><dd class="col-8">{{ candidate.website }}<br>{{ candidate.phone }}</dd><dt class="col-4">Współrzędne</dt><dd class="col-8">{{ candidate.latitude }}, {{ candidate.longitude }}</dd><dt class="col-4">Ocena</dt><dd class="col-8">{{ candidate.discovery_score }}: {{ candidate.discovery_reasons|json_encode }}</dd></dl></div><div class="col-lg-5"><h3>Dane źródłowe</h3><p class="text-muted">Niezmienny, ograniczony snapshot audytowy.</p><pre class="small text-wrap">{{ candidate.source_snapshot|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></div></div>
{% if candidate.status in ['PENDING','NEEDS_MAPPING','POSSIBLE_DUPLICATE'] %}<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'edit'}) }}" class="card card-body mb-3"><h3>Edytuj szkic kandydata</h3><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><input class="form-control mb-2" required name="name" value="{{ candidate.name }}"><input class="form-control mb-2" name="address_line1" value="{{ candidate.address_line1 }}" placeholder="Adres"><input class="form-control mb-2" name="postal_code" value="{{ candidate.postal_code }}" placeholder="Kod pocztowy"><input class="form-control mb-2" name="locality" value="{{ candidate.locality }}" placeholder="Miejscowość"><input class="form-control mb-2" required name="country_code" value="{{ candidate.country_code }}" placeholder="Kraj"><input class="form-control mb-2" required name="latitude" value="{{ candidate.latitude }}"><input class="form-control mb-2" required name="longitude" value="{{ candidate.longitude }}"><input class="form-control mb-2" name="website" value="{{ candidate.website }}" placeholder="WWW"><input class="form-control mb-2" name="phone" value="{{ candidate.phone }}" placeholder="Telefon"><select class="form-select mb-2" name="category_id"><option value="">Brak mapowania</option>{% for category in categories %}<option value="{{ category.id }}" {{ candidate.suggested_place_category_id == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select><button class="btn btn-primary">Zapisz szkic</button></form><form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'refresh'}) }}" class="mb-3"><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><button class="btn btn-outline-secondary">Odśwież ze źródła</button></form>{% endif %}
{% if candidate.status in ['PENDING','POSSIBLE_DUPLICATE'] %}<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'approve'}) }}" class="mb-3"><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><button class="btn btn-success">Zatwierdź jako szkic</button></form>{% endif %}
{% if candidate.status in ['PENDING','NEEDS_MAPPING','POSSIBLE_DUPLICATE'] %}<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'reject'}) }}" class="mb-3"><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><input required name="reason" class="form-control mb-2" placeholder="Powód odrzucenia"><button class="btn btn-danger">Odrzuć</button></form>{% endif %}
{% if candidate.status in ['PENDING','POSSIBLE_DUPLICATE'] %}<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'duplicate'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><select required name="place_id" class="form-select mb-2"><option value="">Wybierz istniejące miejsce</option>{% for p in places %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}</select><button class="btn btn-warning">Oznacz duplikat</button></form>{% endif %}
{% endblock %}
