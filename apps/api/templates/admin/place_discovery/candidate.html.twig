{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}{{ candidate.name }}{% endblock %}
{% block main %}
<div class="row">
  <div class="col-lg-7"><dl class="row">
    <dt class="col-4">Status</dt><dd class="col-8">{{ candidate.status }}</dd>
    <dt class="col-4">Źródło</dt><dd class="col-8">{{ candidate.source }} / {{ candidate.source_release }} / {{ candidate.external_id }}</dd>
    <dt class="col-4">Lokalizacja źródłowa</dt><dd class="col-8">{{ candidate.locality ?: 'brak' }} ({{ candidate.country_code ?: 'brak kraju' }})</dd>
    <dt class="col-4">Wybrane miasto</dt><dd class="col-8">{{ candidate.selected_city_name ?: 'brak' }}{% if candidate.city_selection_source %} ({{ candidate.city_selection_source == 'AUTO' ? 'sugestia automatyczna' : 'wybór administratora' }}){% endif %}</dd>
    <dt class="col-4">Atrybuty</dt><dd class="col-8">wewnątrz: {{ candidate.indoor is null ? 'nieznane' : (candidate.indoor ? 'tak' : 'nie') }}, na zewnątrz: {{ candidate.outdoor is null ? 'nieznane' : (candidate.outdoor ? 'tak' : 'nie') }}, bezpłatne: {{ candidate.free_entry is null ? 'nieznane' : (candidate.free_entry ? 'tak' : 'nie') }}</dd>
    <dt class="col-4">Adres</dt><dd class="col-8">{{ candidate.address_line1 }}, {{ candidate.postal_code }}</dd>
    <dt class="col-4">WWW / telefon</dt><dd class="col-8">{{ candidate.website }}<br>{{ candidate.phone }}</dd>
    <dt class="col-4">Współrzędne</dt><dd class="col-8">{{ candidate.latitude }}, {{ candidate.longitude }}</dd>
    <dt class="col-4">Proweniencja i licencje</dt><dd class="col-8"><pre class="small text-wrap">{{ candidate.source_provenance|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>{% set unresolved = false %}{% for source in candidate.source_provenance %}{% if source.license is not defined or source.license is null or source.license is empty %}{% set unresolved = true %}{% endif %}{% endfor %}{% if unresolved %}<strong class="text-danger">Licencja nierozstrzygnięta. Zatwierdzenie jest zablokowane do jawnego przeglądu.</strong>{% endif %}</dd>
    {% if candidate.source_closed_review_required %}<dt class="col-4">Wymaga kontroli</dt><dd class="col-8 text-danger">Źródło zgłosiło trwałe zamknięcie. Publiczne Miejsce nie zostało zmienione.</dd>{% endif %}
  </dl></div>
  <div class="col-lg-5"><h3>Prywatny snapshot źródłowy</h3><p class="text-muted">Widoczny wyłącznie dla administratora; nigdy nie jest publikowany.</p><pre class="small text-wrap">{{ candidate.source_snapshot|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></div>
</div>
{% if candidate.status in ['PENDING','NEEDS_MAPPING','POSSIBLE_DUPLICATE'] %}
<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'resolve-license'}) }}" class="card card-body mb-3"><h3>Rozstrzygnięcie licencji źródła</h3><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><input required maxlength="255" name="license" class="form-control mb-2" placeholder="Zweryfikowany identyfikator licencji"><button class="btn btn-outline-danger">Zapisz jawne rozstrzygnięcie</button></form>
<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'edit'}) }}" class="card card-body mb-3">
  <h3>Dane do zatwierdzenia</h3>
  <input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}">
  <input class="form-control mb-2" required name="name" value="{{ candidate.name }}"><input class="form-control mb-2" name="address_line1" value="{{ candidate.address_line1 }}" placeholder="Adres"><input class="form-control mb-2" name="postal_code" value="{{ candidate.postal_code }}" placeholder="Kod pocztowy"><input class="form-control mb-2" name="locality" value="{{ candidate.locality }}" placeholder="Lokalizacja źródłowa"><input class="form-control mb-2" required name="country_code" value="{{ candidate.country_code }}" placeholder="Kraj"><input class="form-control mb-2" required name="latitude" value="{{ candidate.latitude }}"><input class="form-control mb-2" required name="longitude" value="{{ candidate.longitude }}"><input class="form-control mb-2" name="website" value="{{ candidate.website }}" placeholder="WWW"><input class="form-control mb-2" name="phone" value="{{ candidate.phone }}" placeholder="Telefon">
  <select class="form-select mb-2" name="category_id"><option value="">Brak mapowania kategorii</option>{% for category in categories %}<option value="{{ category.id }}" {{ candidate.suggested_place_category_id == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select>
  <select class="form-select mb-2" name="city_id"><option value="">Wybierz istniejące miasto</option>{% for city in cities %}<option value="{{ city.id }}" {{ candidate.suggested_city_id == city.id ? 'selected' : '' }}>{{ city.country_code }} - {{ city.name }}</option>{% endfor %}</select>
  {% for field,label in {'indoor':'Wewnątrz','outdoor':'Na zewnątrz','free_entry':'Wstęp bezpłatny'} %}<label class="form-label">{{ label }}</label><select class="form-select mb-2" name="{{ field }}"><option value="">Nieznane</option><option value="1" {{ attribute(candidate,field) is same as(true) ? 'selected' : '' }}>Tak</option><option value="0" {{ attribute(candidate,field) is same as(false) ? 'selected' : '' }}>Nie</option></select>{% endfor %}
  <button class="btn btn-primary">Zapisz dane przeglądu</button>
</form>
<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'refresh'}) }}" class="mb-3"><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><button class="btn btn-outline-secondary">Przywróć pola ze źródła</button></form>
{% endif %}
{% if candidate.status in ['PENDING','POSSIBLE_DUPLICATE'] %}<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'approve'}) }}" class="mb-3"><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><button class="btn btn-success">Zatwierdź jako szkic</button></form>{% endif %}
{% if candidate.status in ['PENDING','NEEDS_MAPPING','POSSIBLE_DUPLICATE'] %}<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'reject'}) }}" class="mb-3"><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><input required name="reason" class="form-control mb-2" placeholder="Powód odrzucenia"><button class="btn btn-danger">Odrzuć</button></form>{% endif %}
{% if candidate.status in ['PENDING','POSSIBLE_DUPLICATE'] %}<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'duplicate'}) }}" class="mb-3"><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><select required name="place_id" class="form-select mb-2"><option value="">Wybierz istniejące miejsce</option>{% for p in places %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}</select><button class="btn btn-warning">Oznacz duplikat</button></form>{% endif %}
{% if candidate.status == 'POSSIBLE_DUPLICATE' %}<form method="post" action="{{ path('admin_place_discovery_candidate_action',{id:candidate.id,action:'clear-duplicate'}) }}" class="mb-3"><input type="hidden" name="_token" value="{{ csrf_token('candidate-'~candidate.id) }}"><input type="hidden" name="version" value="{{ candidate.version }}"><button class="btn btn-outline-warning">Wyczyść ostrzeżenie o duplikacie</button></form>{% endif %}
<h3>Historia przeglądu</h3><table class="table table-sm"><thead><tr><th>Czas</th><th>Aktor</th><th>Akcja</th><th>Status</th><th>Zmiany / powód</th></tr></thead><tbody>{% for event in history %}<tr><td>{{ event.created_at }}</td><td>{{ event.actor_type }} {{ event.actor_id }}</td><td>{{ event.action }}</td><td>{{ event.previous_status }} → {{ event.next_status }}</td><td>{{ event.changed_fields|json_encode }}{% if event.reason %}<br>{{ event.reason }}{% endif %}</td></tr>{% else %}<tr><td colspan="5">Brak zdarzeń.</td></tr>{% endfor %}</tbody></table>
{% endblock %}
