{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Kandydaci miejsc{% endblock %}
{% block main %}
<div class="mb-3"><a class="btn btn-outline-danger" href="{{ path('admin',{routeName:'admin_place_discovery_candidates',actionable:1,status:'APPROVED'}) }}">Wymagające przeglądu</a></div>
<form method="get" action="{{ path('admin') }}" class="row g-2 mb-3"><input type="hidden" name="routeName" value="admin_place_discovery_candidates"><div class="col"><input class="form-control" name="status" value="{{ filters.status|default('') }}" placeholder="Status"></div><div class="col"><input class="form-control" name="locality" value="{{ filters.locality|default('') }}" placeholder="Miejscowość"></div><div class="col"><input class="form-control" name="source_release" value="{{ filters.source_release|default('') }}" placeholder="Wydanie"></div><div class="col"><select class="form-select" name="license_review_required"><option value="">Przegląd licencji: wszystkie</option><option value="1" {{ filters.license_review_required|default('') == '1' ? 'selected' : '' }}>Wymagany</option><option value="0" {{ filters.license_review_required|default('') == '0' ? 'selected' : '' }}>Niewymagany</option></select></div><div class="col"><select class="form-select" name="closure_review_required"><option value="">Przegląd zamknięcia: wszystkie</option><option value="1" {{ filters.closure_review_required|default('') == '1' ? 'selected' : '' }}>Wymagany</option><option value="0" {{ filters.closure_review_required|default('') == '0' ? 'selected' : '' }}>Niewymagany</option></select></div><div class="col"><select class="form-select" name="perPage"><option value="25" {{ perPage == 25 ? 'selected' : '' }}>25</option><option value="50" {{ perPage == 50 ? 'selected' : '' }}>50</option><option value="100" {{ perPage == 100 ? 'selected' : '' }}>100</option></select></div><div class="col"><button class="btn btn-primary">Filtruj</button></div></form>
<p class="text-muted">Wyniki {{ rangeStart }}-{{ rangeEnd }} z {{ total }}</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Nazwa</th><th>Miejscowość</th><th>Kategoria</th><th>Pewność</th><th>Wynik</th><th>Powód</th><th>Wydanie</th><th>Przegląd</th><th>Status</th></tr></thead><tbody>{% for c in candidates %}<tr><td><a href="{{ path('admin',{routeName:'admin_place_discovery_candidate',routeParams:{id:c.id}}) }}">{{ c.name }}</a></td><td>{{ c.locality }}</td><td>{{ c.category_name|default('brak mapowania') }}</td><td>{{ c.confidence }}</td><td>{{ c.discovery_score }}</td><td>{{ c.discovery_reasons|json_encode }}</td><td>{{ c.source_release }}</td><td>{% if c.source_license_review_required %}<span class="badge bg-danger">licencja</span>{% endif %} {% if c.source_closed_review_required %}<span class="badge bg-warning text-dark">zamknięcie</span>{% endif %}</td><td><span class="badge bg-secondary">{{ c.status }}</span></td></tr>{% else %}<tr><td colspan="9">Brak kandydatów.</td></tr>{% endfor %}</tbody></table></div>
{% set query = filters|merge({routeName:'admin_place_discovery_candidates',perPage:perPage}) %}<nav aria-label="Paginacja kandydatów"><ul class="pagination"><li class="page-item {{ page <= 1 ? 'disabled' : '' }}">{% if page > 1 %}<a class="page-link" href="{{ path('admin',query|merge({page:page-1})) }}">Poprzednia</a>{% else %}<span class="page-link" aria-disabled="true">Poprzednia</span>{% endif %}</li><li class="page-item disabled"><span class="page-link">Strona {{ page }} z {{ lastPage }}</span></li><li class="page-item {{ page >= lastPage ? 'disabled' : '' }}">{% if page < lastPage %}<a class="page-link" href="{{ path('admin',query|merge({page:page+1})) }}">Następna</a>{% else %}<span class="page-link" aria-disabled="true">Następna</span>{% endif %}</li></ul></nav>
{% endblock %}
