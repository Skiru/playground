{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Kandydaci miejsc{% endblock %}
{% block main %}
<form method="get" class="row g-2 mb-3"><div class="col"><input class="form-control" name="status" value="{{ filters.status|default('') }}" placeholder="Status"></div><div class="col"><input class="form-control" name="locality" value="{{ filters.locality|default('') }}" placeholder="Miejscowość"></div><div class="col"><input class="form-control" name="source_release" value="{{ filters.source_release|default('') }}" placeholder="Wydanie"></div><div class="col"><button class="btn btn-primary">Filtruj</button></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Nazwa</th><th>Miejscowość</th><th>Kategoria</th><th>Pewność</th><th>Wynik</th><th>Powód</th><th>Wydanie</th><th>Status</th></tr></thead><tbody>{% for c in candidates %}<tr><td><a href="{{ path('admin',{routeName:'admin_place_discovery_candidate',routeParams:{id:c.id}}) }}">{{ c.name }}</a></td><td>{{ c.locality }}</td><td>{{ c.category_name|default('brak mapowania') }}</td><td>{{ c.confidence }}</td><td>{{ c.discovery_score }}</td><td>{{ c.discovery_reasons|json_encode }}</td><td>{{ c.source_release }}</td><td><span class="badge bg-secondary">{{ c.status }}</span></td></tr>{% else %}<tr><td colspan="8">Brak kandydatów.</td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
