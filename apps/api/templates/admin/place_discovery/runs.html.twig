{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Przebiegi odkrywania{% endblock %}
{% block main %}
<form method="post" action="{{ path('admin_place_discovery_run_action') }}" class="card card-body mb-3"><input type="hidden" name="_token" value="{{ csrf_token('discovery-runs') }}"><input type="hidden" name="action" value="run-now"><label>Ograniczony przebieg dla jednego obszaru</label><select required name="area_id" class="form-select mb-2">{% for area in areas %}<option value="{{ area.id }}">{{ area.name }}</option>{% endfor %}</select><button class="btn btn-primary" {{ areas is empty ? 'disabled' : '' }}>Uruchom teraz</button></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Źródło / wydanie</th><th>Obszar / próba</th><th>Status / właściciel</th><th>Start / koniec / heartbeat</th><th>Liczniki</th><th>Próbki</th><th>Operacje</th></tr></thead><tbody>
{% for r in runs %}<tr><td>{{ r.source }}<br>{{ r.source_release }}</td><td>{{ r.area_name }}<br>#{{ r.attempt }} {{ r.trigger_type }}</td><td>{{ r.status }}<br>{{ r.worker_id }}</td><td>{{ r.started_at }}<br>{{ r.completed_at }}<br>{{ r.last_heartbeat_at }}</td><td>odkryte {{ r.discovered_count }}, dodane {{ r.inserted_count }}, odświeżone {{ r.updated_count }}, linki {{ r.linked_count }}, pominięte {{ r.skipped_count }}, błędy {{ r.failed_count }}</td><td><small>{{ r.error_summary }}<br>{{ r.error_samples|json_encode }}<br>{{ r.skipped_reasons|json_encode }}</small></td><td>{% if r.status in ['FAILED','PARTIAL'] %}<form method="post" action="{{ path('admin_place_discovery_run_action') }}"><input type="hidden" name="_token" value="{{ csrf_token('discovery-runs') }}"><input type="hidden" name="action" value="retry"><input type="hidden" name="run_id" value="{{ r.id }}"><button class="btn btn-sm btn-warning">Nowa próba</button></form>{% endif %}{% if r.status == 'RUNNING' %}<form method="post" action="{{ path('admin_place_discovery_run_action') }}"><input type="hidden" name="_token" value="{{ csrf_token('discovery-runs') }}"><input type="hidden" name="action" value="recover-stale"><input type="hidden" name="run_id" value="{{ r.id }}"><button class="btn btn-sm btn-outline-danger">Odzyskaj wygasłą dzierżawę</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="7">Brak przebiegów.</td></tr>{% endfor %}
</tbody></table></div>
{% endblock %}
