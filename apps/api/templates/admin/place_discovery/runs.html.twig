{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Przebiegi odkrywania{% endblock %}
{% block main %}<div class="table-responsive"><table class="table"><thead><tr><th>Źródło</th><th>Wydanie</th><th>Obszar</th><th>Status</th><th>Start / koniec</th><th>Pobrane</th><th>Dodane</th><th>Odświeżone</th><th>Błędy</th></tr></thead><tbody>{% for r in runs %}<tr><td>{{ r.source }}</td><td>{{ r.source_release }}</td><td>{{ r.area_name }}</td><td>{{ r.status }}</td><td>{{ r.started_at }}<br>{{ r.completed_at }}</td><td>{{ r.discovered_count }}</td><td>{{ r.inserted_count }}</td><td>{{ r.updated_count }}</td><td title="{{ r.error_summary }}">{{ r.failed_count }}</td></tr>{% else %}<tr><td colspan="9">Brak przebiegów.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
