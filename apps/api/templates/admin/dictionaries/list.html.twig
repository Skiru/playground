{% extends '@EasyAdmin/page/content.html.twig' %}

{% block title %}
    {% if type == 'cities' %}Miasta{% elseif type == 'categories' %}Kategorie{% else %}Udogodnienia{% endif %} | FamilyPlaces Admin
{% endblock %}

{% block content_title %}
    {% if type == 'cities' %}Miasta{% elseif type == 'categories' %}Kategorie{% else %}Udogodnienia{% endif %}
{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_dictionary_new', {type: type}) }}" class="btn btn-primary">
        <i class="fa fa-plus me-1"></i> Dodaj wpis
    </a>
{% endblock %}

{% block main %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="padding-left: 1.25rem;">Nazwa</th>
                            <th>Slug</th>
                            {% if type == 'cities' %}
                                <th>Kraj</th>
                                <th>Współrzędne</th>
                                <th>Timezone</th>
                            {% elseif type == 'categories' %}
                                <th>Ikona</th>
                                <th>Kolejność</th>
                                <th>Opis</th>
                            {% else %}
                                <th>Grupa</th>
                                <th>Ikona</th>
                                <th>Kolejność</th>
                            {% endif %}
                            <th>Status</th>
                            <th class="text-end" style="padding-right: 1.25rem;">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for item in items %}
                        <tr>
                            <td class="fw-bold" style="padding-left: 1.25rem;">{{ item.name }}</td>
                            <td><code class="text-muted">{{ item.slug }}</code></td>
                            {% if type == 'cities' %}
                                <td><span class="badge bg-secondary">{{ item.country_code }}</span></td>
                                <td class="small">{{ item.latitude }}, {{ item.longitude }}</td>
                                <td class="small text-muted">{{ item.timezone }}</td>
                            {% elseif type == 'categories' %}
                                <td><span class="badge bg-light text-dark border"><i class="fa fa-{{ item.icon_key|default('tag') }} me-1"></i> {{ item.icon_key }}</span></td>
                                <td><span class="badge bg-light text-dark">{{ item.display_order }}</span></td>
                                <td class="small text-muted text-truncate" style="max-width: 250px;">{{ item.description|default('—') }}</td>
                            {% else %}
                                <td><span class="badge bg-info text-dark">{{ item.amenity_group }}</span></td>
                                <td><span class="badge bg-light text-dark border"><i class="fa fa-{{ item.icon_key|default('check') }} me-1"></i> {{ item.icon_key }}</span></td>
                                <td><span class="badge bg-light text-dark">{{ item.display_order }}</span></td>
                            {% endif %}
                            <td>
                                {% if item.enabled %}
                                    <span class="badge bg-success">Aktywne</span>
                                {% else %}
                                    <span class="badge bg-secondary">Wyłączone</span>
                                {% endif %}
                            </td>
                            <td class="text-end" style="padding-right: 1.25rem;">
                                <div class="d-inline-flex gap-1">
                                    <a href="{{ path('admin_dictionary_edit', {type: type, id: item.id}) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="fa fa-edit me-1"></i> Edytuj
                                    </a>
                                    <form method="post" action="{{ path('admin_dictionary_delete', {type: type, id: item.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('dictionary-delete-' ~ item.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Czy na pewno chcesz usunąć ten wpis słownikowy?">
                                            <i class="fa fa-trash me-1"></i> Usuń
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">Brak wpisów słownikowych do wyświetlenia.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
