#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
. "$SCRIPT_DIR/lib.sh"

require_env

retry() {
  local n=0
  until "$@"; do
    n=$((n + 1))
    if [ "$n" -ge 12 ]; then
      return 1
    fi
    sleep 2
  done
}

gateway() {
  compose exec -T gateway wget -qO- "http://localhost:80$1"
}

retry gateway / >/dev/null || { compose logs --no-color gateway api web >&2; die 'gateway root failed'; }
retry gateway /healthz | grep -q 'OK' || { compose logs --no-color gateway >&2; die 'gateway healthz failed'; }
retry gateway /api/v1/health/live | grep -q . || { compose logs --no-color gateway api >&2; die 'gateway API liveness failed'; }
retry gateway /admin/login | grep -q '_csrf_token' || { compose logs --no-color gateway api >&2; die 'gateway admin login routing failed'; }

admin_redirect_check() {
  (compose exec -T gateway wget -S -O /dev/null 'http://localhost:80/admin' 2>&1 || true) | grep -Eq ' 302 | 301 '
}
retry admin_redirect_check || die 'gateway /admin route was not proxied to backend redirect'

unknown_api_miss() {
  (compose exec -T gateway wget -S -O /dev/null 'http://localhost:80/api/v1/does-not-exist?probe=path-preservation' 2>&1 || true) | grep -q ' 404 '
}

# An API miss must be produced by the backend, never by the frontend SSR fallback.
retry unknown_api_miss || die 'unknown API route was not a backend 404'

compose exec -T api curl --fail --silent http://localhost/api/v1/health/live >/dev/null
compose exec -T api curl -s -X POST http://localhost/api/v1/auth/google -H "Origin: ${APP_PUBLIC_ORIGIN:-https://playground.com.pl}" -H "Content-Type: application/json" -d '{"credential":"smoke-test"}' | grep -q 'GOOGLE_TOKEN_INVALID' || die 'Google auth endpoint failed or returned unexpected response for invalid token'
compose exec -T api curl -s -X POST http://localhost/api/v1/auth/google -H "Origin: https://invalid-origin.untrusted.test" -H "Content-Type: application/json" -d '{"credential":"smoke-test"}' | grep -q 'GOOGLE_ORIGIN_INVALID' || die 'Google auth origin rejection failed'
compose exec -T api curl -s -f http://localhost/api/v1/session | grep -q '"authenticated"' || die 'Session endpoint failed'
compose exec -T api curl -s -f http://localhost/admin/login | grep -q '_csrf_token' || die 'Admin login endpoint failed'
compose exec -T web node -e "fetch('http://localhost:3000/').then(r=>{if(!r.ok)process.exit(1)})"
compose exec -T database psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc 'SELECT PostGIS_Version()' | grep -q '^3\.6'

# Dozzle and Docker Socket Proxy smoke checks
dozzle_unauth=$(compose exec -T gateway wget -S -O /dev/null --header="Host: logs.${GATEWAY_DOMAIN:-playground.com.pl}" 'http://localhost:80/' 2>&1 || true)
printf '%s\n' "$dozzle_unauth" | grep -q '403' || die 'Dozzle direct unauthenticated access failed to return 403'

dozzle_auth=$(compose exec -T gateway wget -S -O /dev/null --header="Host: logs.${GATEWAY_DOMAIN:-playground.com.pl}" --header="Cf-Access-Authenticated-User-Email: admin@playground.com.pl" 'http://localhost:80/' 2>&1 || true)
printf '%s\n' "$dozzle_auth" | grep -q '200' || die 'Dozzle authenticated access with Cloudflare header failed'

if [ "${STORAGE_DRIVER:-local}" = "s3" ]; then
  key="release-smoke/$(date -u +%s)-$$"
  payload=$(mktemp)
  recovered=$(mktemp)
  trap 'rm -f "$payload" "$recovered"' EXIT
  printf 'familyplaces-r2-smoke-%s' "$key" > "$payload"
  AWS_ACCESS_KEY_ID="$STORAGE_S3_KEY" AWS_SECRET_ACCESS_KEY="$STORAGE_S3_SECRET" aws --endpoint-url "$STORAGE_S3_ENDPOINT" s3 cp "$payload" "s3://$STORAGE_S3_BUCKET/$key" >/dev/null
  AWS_ACCESS_KEY_ID="$STORAGE_S3_KEY" AWS_SECRET_ACCESS_KEY="$STORAGE_S3_SECRET" aws --endpoint-url "$STORAGE_S3_ENDPOINT" s3 cp "s3://$STORAGE_S3_BUCKET/$key" "$recovered" >/dev/null
  cmp -s "$payload" "$recovered" || die 'R2 read-back differs from uploaded bytes'
  AWS_ACCESS_KEY_ID="$STORAGE_S3_KEY" AWS_SECRET_ACCESS_KEY="$STORAGE_S3_SECRET" aws --endpoint-url "$STORAGE_S3_ENDPOINT" s3 rm "s3://$STORAGE_S3_BUCKET/$key" >/dev/null
  printf 'gateway, health, PostGIS, and byte-for-byte R2 smoke passed\n'
else
  compose exec -T api php bin/console app:media-smoke --write-sentinel >/dev/null || die 'local media smoke write-sentinel failed'
  compose exec -T worker php bin/console app:media-smoke --process-sentinel >/dev/null || die 'local media smoke process-sentinel failed'
  compose exec -T api php bin/console app:media-smoke --verify-sentinel >/dev/null || die 'local media smoke verify-sentinel failed'
  compose exec -T api php bin/console app:media-smoke --cleanup >/dev/null || true
  printf 'gateway, health, PostGIS, and local media storage smoke passed\n'
fi
