#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
. "$SCRIPT_DIR/lib.sh"

dry_run="${1:-}"
case "$dry_run" in
  ""|--dry-run) ;;
  *) die 'usage: backup-retention [--dry-run]' ;;
esac

require_env
command -v jq >/dev/null 2>&1 || die 'jq is required'

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

backup_aws s3api list-objects-v2 --bucket "$BACKUP_S3_BUCKET" --prefix "$(backup_prefix)/" --output json > "$work/list.json"
if [ "$(jq -r '.IsTruncated // false' "$work/list.json")" != "false" ]; then
  die 'refusing retention on partial object listing'
fi

for kind in daily weekly pre-deploy; do
  keep=7
  [ "$kind" = "weekly" ] && keep=4
  [ "$kind" = "pre-deploy" ] && keep=3

  mapfile -t manifests < <(jq -r --arg prefix "$(backup_prefix)/$kind/" '.Contents[]?.Key | select(startswith($prefix) and test("^familyplaces/postgres/(daily|weekly|pre-deploy)/familyplaces-(daily|weekly|pre-deploy)-[0-9]{8}T[0-9]{6}Z\\.manifest\\.json$"))' "$work/list.json" | sort -r)

  if [ "${#manifests[@]}" -le "$keep" ]; then
    continue
  fi

  for manifest in "${manifests[@]:keep}"; do
    [ -n "$manifest" ] || continue
    base="${manifest%.manifest.json}"
    for key in "$base.dump.age" "$base.dump.age.sha256" "$manifest"; do
      if [ "$dry_run" = "--dry-run" ]; then
        printf 'would delete %s\n' "$key"
      else
        backup_aws s3api delete-object --bucket "$BACKUP_S3_BUCKET" --key "$key" >/dev/null
      fi
    done
  done
done
