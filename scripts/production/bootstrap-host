#!/bin/bash
set -euo pipefail

[ "${EUID:-$(id -u)}" -eq 0 ] || { printf 'run as root during initial host provisioning\n' >&2; exit 1; }
[ -r /etc/os-release ] && . /etc/os-release

if [ "${ID:-}" != "ubuntu" ]; then
  printf 'requires Ubuntu\n' >&2
  exit 1
fi

arch=$(uname -m)
case "$arch" in
  x86_64|aarch64|arm64) ;;
  *) printf 'unsupported architecture: %s\n' "$arch" >&2; exit 1 ;;
esac

deploy_user=${SUDO_USER:-${DEPLOY_USER:-ubuntu}}
id "$deploy_user" >/dev/null 2>&1 || { printf 'deployment user does not exist: %s\n' "$deploy_user" >&2; exit 1; }

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl gnupg lsb-release apt-transport-https jq awscli age chrony unattended-upgrades ufw util-linux postgresql-client logrotate

install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

deb_arch="amd64"
if [ "$arch" = "aarch64" ] || [ "$arch" = "arm64" ]; then
  deb_arch="arm64"
fi

printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu %s stable\n' "$deb_arch" "${VERSION_CODENAME}" > /etc/apt/sources.list.d/docker.list

apt-get update
apt-get remove -y docker.io docker-compose docker-compose-v2 podman-docker containerd runc || true
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker containerd chrony unattended-upgrades
usermod -aG docker "$deploy_user"

install -d -m 0750 -o "$deploy_user" -g "$deploy_user" /srv/familyplaces /etc/familyplaces /opt/familyplaces

if ! swapon --noheadings --show | grep -q .; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  grep -q '^/swapfile ' /etc/fstab || printf '/swapfile none swap sw 0 0\n' >> /etc/fstab
fi

install -d -m 0755 /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{"log-driver":"local","log-opts":{"max-size":"10m","max-file":"3"}}
JSON

cat > /etc/logrotate.d/docker-familyplaces <<'EOF'
/var/lib/docker/containers/*/*.log { daily rotate 7 compress missingok notifempty copytruncate }
EOF

ufw default deny incoming
ufw default allow outgoing
ufw allow OpenSSH
ufw --force enable

systemctl restart docker

docker version >/dev/null
docker compose version >/dev/null
docker buildx version >/dev/null
flock --version >/dev/null

printf 'host baseline configured; Docker packages follow Docker official apt stable repository; re-login is required for docker group membership\n'
