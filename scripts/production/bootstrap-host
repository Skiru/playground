#!/usr/bin/env zsh
set -Eeuo pipefail
[[ $EUID -eq 0 ]] || { print -u2 'run as root during initial host provisioning'; exit 1; }
[[ -r /etc/os-release ]] && source /etc/os-release
[[ ${ID:-} == ubuntu && ${VERSION_ID:-} == 24.04 ]] || { print -u2 'requires Ubuntu 24.04'; exit 1; }
[[ $(uname -m) == aarch64 ]] || { print -u2 'requires aarch64'; exit 1; }
deploy_user=${SUDO_USER:-${DEPLOY_USER:-ubuntu}}
id "$deploy_user" >/dev/null 2>&1 || { print -u2 "deployment user does not exist: $deploy_user"; exit 1; }
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl gnupg lsb-release apt-transport-https zsh jq awscli age chrony unattended-upgrades ufw util-linux postgresql-client logrotate
install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
printf '%s\n' "deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu ${VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get remove -y docker.io docker-compose docker-compose-v2 podman-docker containerd runc || true
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker containerd chrony unattended-upgrades
usermod -aG docker "$deploy_user"
install -d -m 0750 -o "$deploy_user" -g "$deploy_user" /srv/familyplaces /etc/familyplaces
if ! swapon --noheadings --show | grep -q .; then fallocate -l 2G /swapfile; chmod 600 /swapfile; mkswap /swapfile; swapon /swapfile; grep -q '^/swapfile ' /etc/fstab || print '/swapfile none swap sw 0 0' >> /etc/fstab; fi
install -d -m 0755 /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{"log-driver":"local","log-opts":{"max-size":"10m","max-file":"3"}}
JSON
cat > /etc/logrotate.d/docker-familyplaces <<'EOF'
/var/lib/docker/containers/*/*.log { daily rotate 7 compress missingok notifempty copytruncate }
EOF
ufw default deny incoming; ufw default allow outgoing; ufw allow OpenSSH; ufw --force enable
systemctl restart docker
docker version >/dev/null; docker compose version >/dev/null; docker buildx version >/dev/null; flock --version >/dev/null
print 'host baseline configured; Docker packages follow Docker official apt stable repository; re-login is required for docker group membership'
