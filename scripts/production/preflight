#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/lib.sh"

require_env

target_platform="${TARGET_PLATFORM:-linux/amd64}"

command -v docker >/dev/null 2>&1 || die 'Docker is required'
command -v docker compose >/dev/null 2>&1 || die 'Docker Compose v2 is required'
command -v jq >/dev/null 2>&1 || die 'jq is required'
command -v python3 >/dev/null 2>&1 || die 'python3 is required'

mem_bytes=$(sysctl -n hw.memsize 2>/dev/null || free -b 2>/dev/null | awk '/Mem:/ {print $2}' || echo 0)
if [ "$mem_bytes" -gt 0 ] && [ "$mem_bytes" -lt 3750000000 ]; then
  die 'at least 4 GB RAM is required'
fi

"$ROOT/scripts/validate-production-env" "$ENV_FILE"

resolved_dozzle_image=${DOZZLE_IMAGE:-amir20/dozzle:v8.11.8@sha256:d6b43130cdee36aab01a1a1fae7f83b2b8db63c1ee3b5ef61781cb947967bc9b}
resolved_dozzle_socket_proxy_image=${DOZZLE_SOCKET_PROXY_IMAGE:-tecnativa/docker-socket-proxy:0.1.1@sha256:6c22b9545adc95258af9deffdde6c0ce0a0a70716771e5a4e02d24d1b6e0dda1}
resolved_gateway_image=${GATEWAY_IMAGE:-caddy:2.10.0-alpine@sha256:ae4458638da8e1a91aafffb231c5f8778e964bca650c8a8cb23a7e8ac557aa3c}
resolved_cloudflared_image=${CLOUDFLARED_IMAGE:-cloudflare/cloudflared:2026.7.0@sha256:5e49861633763e8933475477c20bae6039ed47f32c1d267a34babc347f28f0df}

for image in "${API_IMAGE:-}" "${WEB_IMAGE:-}" "${POSTGIS_IMAGE:-}" "${CF_ACCESS_VALIDATOR_IMAGE:-}" "$resolved_dozzle_image" "$resolved_dozzle_socket_proxy_image" "$resolved_gateway_image" "$resolved_cloudflared_image"; do
  [ -n "$image" ] || die 'API_IMAGE, WEB_IMAGE, POSTGIS_IMAGE, and CF_ACCESS_VALIDATOR_IMAGE must be defined'
  case "$image" in
    *@sha256:[0-9a-f]*);;
    *) die "image $image must be an immutable @sha256 digest reference" ;;
  esac

  inspect_output=$(docker buildx imagetools inspect "$image" 2>&1) || die "failed to inspect image $image: $inspect_output"
  if ! printf '%s\n' "$inspect_output" | grep -q "$target_platform"; then
    die "image $image does not provide the specified platform ($target_platform)"
  fi
done

legacy_containers=$(docker ps --filter "label=com.docker.compose.project=familyplaces" --format '{{.Names}}' 2>/dev/null || true)
if [ -n "$legacy_containers" ]; then
  die "Legacy Compose project 'familyplaces' containers are currently active on host: $legacy_containers. You must stop the legacy stack with 'docker compose -p familyplaces down' before proceeding."
fi

cf_token_file="${CLOUDFLARE_TUNNEL_TOKEN_FILE:-/etc/familyplaces/cloudflared-token}"
if [ ! -r "$cf_token_file" ]; then
  die "Missing Cloudflare tunnel token: PATH=$cf_token_file"
fi

if [ "${STORAGE_DRIVER:-local}" = "s3" ]; then
  command -v aws >/dev/null 2>&1 || die 'AWS CLI is required when STORAGE_DRIVER=s3'
  AWS_ACCESS_KEY_ID="$STORAGE_S3_KEY" AWS_SECRET_ACCESS_KEY="$STORAGE_S3_SECRET" aws --endpoint-url "$STORAGE_S3_ENDPOINT" s3api head-bucket --bucket "$STORAGE_S3_BUCKET" >/dev/null
fi

if [ "${BACKUP_ENABLED:-false}" = "true" ]; then
  command -v aws >/dev/null 2>&1 || die 'AWS CLI is required when BACKUP_ENABLED=true'
  AWS_ACCESS_KEY_ID="$BACKUP_S3_KEY" AWS_SECRET_ACCESS_KEY="$BACKUP_S3_SECRET" aws --endpoint-url "$BACKUP_S3_ENDPOINT" s3api head-bucket --bucket "$BACKUP_S3_BUCKET" >/dev/null
fi

compose config --quiet
printf 'preflight passed (credentials and values redacted)\n'
