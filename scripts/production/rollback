#!/usr/bin/env zsh
set -Eeuo pipefail
source "${0:A:h}/lib.zsh"
validate_only=false
if [[ ${1:-} == --validate-only ]]; then validate_only=true; shift; fi
target=${1:-}; [[ -n $target && -f $target ]] || die 'usage: rollback [--validate-only] <immutable-release-descriptor.json>'
require_env; source "$ENV_FILE"; command -v jq >/dev/null || die 'jq is required'
[[ $(jq -r .rollbackCompatibility "$target") == image-only ]] || die 'refusing rollback: target lacks an image-only migration compatibility certificate'
for key in releaseSha releaseTree releaseVersion apiImageDigest webImageDigest postgisImageDigest; do jq -e --arg key "$key" '.[$key] | strings | select(length > 0)' "$target" >/dev/null || die "invalid descriptor: $key"; done
if [[ $validate_only == true ]]; then print 'rollback descriptor accepted'; exit 0; fi
mkdir -p "$ROOT/.production"; exec 9>"$ROOT/.production/deploy.lock"; flock -n 9 || die 'another deployment is active'
export API_IMAGE=$(jq -r .apiImageDigest "$target") WEB_IMAGE=$(jq -r .webImageDigest "$target") POSTGIS_IMAGE=$(jq -r .postgisImageDigest "$target")
compose pull; compose up --wait -d worker api web gateway cloudflared; "${0:A:h}/smoke"
print 'image rollback completed; no database downgrade was attempted'
