#!/bin/sh
set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
. "$SCRIPT_DIR/lib.sh"

release_arg=""
dry_run=false
print_release=false

while [ $# -gt 0 ]; do
  case "$1" in
    --release=*)
      release_arg="${1#*=}"
      shift
      ;;
    --release|-r)
      if [ $# -lt 2 ]; then
        die "usage: $0 --release <release-version>"
      fi
      release_arg="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --print-release)
      print_release=true
      shift
      ;;
    *)
      if [ -z "$release_arg" ]; then
        release_arg="$1"
        shift
      else
        die "unexpected argument: $1"
      fi
      ;;
  esac
done

if [ -z "$release_arg" ]; then
  die "usage: ./scripts/production/deploy --release <release-version>"
fi

# Reject 40-char SHA explicitly if passed directly as --release
case "$release_arg" in
  [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
    die "expected release version"
    ;;
esac

if [ "$dry_run" = "false" ] && [ "$print_release" = "false" ]; then
  printf '[1/7] Loading production configuration\n'
fi
require_env

if [ "$dry_run" = "false" ] && [ "$print_release" = "false" ]; then
  printf '[2/7] Resolving release %s\n' "$release_arg"
fi

mkdir -p "$(release_dir)" "$ROOT/.production"

resolved_manifest=$(mktemp "$ROOT/.production/.manifest.XXXXXX.json" 2>/dev/null || mktemp /tmp/.manifest.XXXXXX.json)
trap 'rm -f "$resolved_manifest"' EXIT

python3 "$ROOT/scripts/release/release_manifest.py" resolve "$release_arg" --output "$resolved_manifest" >/dev/null

export RELEASE_VERSION=$(jq -r .releaseVersion "$resolved_manifest")
export RELEASE_SHA=$(jq -r .sourceSha "$resolved_manifest")
export API_IMAGE=$(jq -r '.images[] | select(.component=="api") | .name + "@" + .manifestDigest' "$resolved_manifest")
export WEB_IMAGE=$(jq -r '.images[] | select(.component=="web") | .name + "@" + .manifestDigest' "$resolved_manifest")
export POSTGIS_IMAGE=$(jq -r '.images[] | select(.component=="postgis") | .name + "@" + .manifestDigest' "$resolved_manifest")

arch=$(uname -m)
case "$arch" in
  x86_64) host_platform="linux/amd64" ;;
  aarch64|arm64) host_platform="linux/arm64" ;;
  *) host_platform="linux/unknown" ;;
esac

if [ "$dry_run" = "false" ] && [ "$print_release" = "false" ]; then
  printf '[3/7] Checking host architecture: %s\n' "$host_platform"
  printf '[4/7] Verifying immutable images and configuration\n'
fi

"$SCRIPT_DIR/preflight"

# Check discovery mode: if PLACE_DISCOVERY_ENABLED is false/unset, ensure discovery services are not in active compose
active_services=$(compose config --services 2>/dev/null || true)
if [ "${PLACE_DISCOVERY_ENABLED:-false}" != "true" ]; then
  if printf '%s\n' "$active_services" | grep -q 'place-discovery'; then
    die "discovery is disabled but discovery services are active in compose"
  fi
fi

if [ "$print_release" = "true" ]; then
  printf 'Release: %s\n' "$RELEASE_VERSION"
  printf 'Source SHA: %s\n' "$RELEASE_SHA"
  printf 'Host platform: %s\n' "$host_platform"
  printf 'API: %s\n' "$API_IMAGE"
  printf 'WEB: %s\n' "$WEB_IMAGE"
  printf 'POSTGIS: %s\n' "$POSTGIS_IMAGE"
  printf 'Storage: %s\n' "${STORAGE_DRIVER:-local}"
  printf 'Backup: %s\n' "$( [ "${BACKUP_ENABLED:-false}" = "true" ] && echo "enabled" || echo "disabled" )"
  printf 'Discovery: %s\n' "$( [ "${PLACE_DISCOVERY_ENABLED:-false}" = "true" ] && echo "enabled" || echo "disabled" )"
  exit 0
fi

if [ "$dry_run" = "true" ]; then
  printf 'Release: %s\n' "$RELEASE_VERSION"
  printf 'Source SHA: %s\n' "$RELEASE_SHA"
  printf 'Host platform: %s\n' "$host_platform"
  printf 'API: %s\n' "$API_IMAGE"
  printf 'WEB: %s\n' "$WEB_IMAGE"
  printf 'POSTGIS: %s\n' "$POSTGIS_IMAGE"
  printf 'Storage: %s\n' "${STORAGE_DRIVER:-local}"
  printf 'Backup: %s\n' "$( [ "${BACKUP_ENABLED:-false}" = "true" ] && echo "enabled" || echo "disabled" )"
  printf 'Discovery: %s\n' "$( [ "${PLACE_DISCOVERY_ENABLED:-false}" = "true" ] && echo "enabled" || echo "disabled" )"
  exit 0
fi

exec 9>"$ROOT/.production/deploy.lock"
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || die 'another deployment is active'
fi

printf '[5/7] Pulling images\n'
compose pull

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
previous=$(release_descriptor)
if [ -f "$previous" ]; then
  cp "$previous" "$(release_dir)/$timestamp.previous.json"
fi

if [ "${BACKUP_ENABLED:-false}" = "true" ]; then
  backup_object=$("$SCRIPT_DIR/backup" pre-deploy)
else
  backup_object="disabled"
fi

printf '[6/7] Applying database migrations\n'
compose up --wait -d database

before=$(compose exec -T database psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "SELECT COALESCE(max(version), '') FROM doctrine_migration_versions" 2>/dev/null || true)
compose run --rm --no-deps api php bin/console doctrine:migrations:migrate --no-interaction
after=$(compose exec -T database psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "SELECT COALESCE(max(version), '') FROM doctrine_migration_versions" 2>/dev/null || true)

printf '[7/7] Starting services and running smoke tests\n'
if compose config --services 2>/dev/null | grep -q '^cloudflared$'; then
  compose up --wait -d worker api web gateway cloudflared
else
  compose up --wait -d worker api web gateway
fi

"$SCRIPT_DIR/smoke"

descriptor="$(release_dir)/$timestamp-${RELEASE_SHA}.json"
jq -n \
  --arg release "v${RELEASE_VERSION}" \
  --arg sha "$RELEASE_SHA" \
  --arg tree "$(git -C "$ROOT" rev-parse HEAD^{tree} 2>/dev/null || echo "$RELEASE_SHA")" \
  --arg version "$RELEASE_VERSION" \
  --arg arch "$host_platform" \
  --arg api "$API_IMAGE" \
  --arg web "$WEB_IMAGE" \
  --arg postgis "$POSTGIS_IMAGE" \
  --arg before "$before" \
  --arg after "$after" \
  --arg storage "${STORAGE_DRIVER:-local}" \
  --arg backup "${BACKUP_ENABLED:-false}" \
  --arg discovery "${PLACE_DISCOVERY_ENABLED:-false}" \
  --arg backupObj "$backup_object" \
  --arg deployed "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '{
    release: $release,
    sourceSha: $sha,
    releaseTree: $tree,
    releaseVersion: $version,
    hostArchitecture: $arch,
    images: {
      api: $api,
      web: $web,
      postgis: $postgis
    },
    storageDriver: $storage,
    backupEnabled: ($backup == "true"),
    discoveryEnabled: ($discovery == "true"),
    migration: {
      versionBefore: $before,
      versionAfter: $after
    },
    rollbackCompatibility: (if $before == $after then "image-only" else "requires-explicit-certificate" end),
    backupObject: $backupObj,
    backupChecksumObject: (if $backupObj == "disabled" then "disabled" else ($backupObj+".sha256") end),
    deployedAt: $deployed
  }' > "$descriptor"

cp "$descriptor" "$(release_descriptor)"

printf '\nSUCCESS\n'
printf 'Release: v%s\n' "$RELEASE_VERSION"
printf 'Commit: %s\n' "$RELEASE_SHA"
printf 'Architecture: %s\n' "$host_platform"
printf 'API: %s\n' "$API_IMAGE"
printf 'WEB: %s\n' "$WEB_IMAGE"
printf 'POSTGIS: %s\n' "$POSTGIS_IMAGE"
printf 'Storage: %s\n' "${STORAGE_DRIVER:-local}"
printf 'Backups: %s\n' "$( [ "${BACKUP_ENABLED:-false}" = "true" ] && echo "enabled" || echo "disabled" )"
printf 'Discovery: %s\n' "$( [ "${PLACE_DISCOVERY_ENABLED:-false}" = "true" ] && echo "enabled" || echo "disabled" )"
