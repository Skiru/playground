#!/bin/sh
set -eu

version=${1:?usage: verify-published <semver> <full-sha> [source-tree]}
source_sha=${2:?usage: verify-published <semver> <full-sha> [source-tree]}
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source_tree=${3:-$(git -C "$repo_dir" rev-parse "${source_sha}^{tree}")}
output_dir="$repo_dir/release-manifest"

mkdir -p "$output_dir"
python3 "$repo_dir/scripts/release/release_manifest.py" from-registry \
  "$output_dir/release.json" "$version" "$source_sha" "$source_tree"
