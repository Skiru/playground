#!/bin/sh
set -eu
env_file=${1:-.env.production}
[ -f "$env_file" ] || { echo 'missing production environment file' >&2; exit 1; }
set -a; . "$env_file"; set +a
fail() { echo "production environment validation failed: $1" >&2; exit 1; }
driver=${STORAGE_DRIVER:-local}
case "$driver" in
  local|s3) ;;
  *) fail 'STORAGE_DRIVER must be either local or s3';;
esac

backup_enabled=${BACKUP_ENABLED:-true}
case "$backup_enabled" in
  true|false) ;;
  *) fail 'BACKUP_ENABLED must be either true or false';;
esac

common_required='APP_SECRET POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD DATABASE_URL RELEASE_SHA RELEASE_VERSION API_IMAGE WEB_IMAGE POSTGIS_IMAGE MAP_ATTRIBUTION CLOUDFLARE_TUNNEL_TOKEN_FILE DOZZLE_USERS_FILE APP_PUBLIC_ORIGIN TRUSTED_AUTH_ORIGINS STORAGE_DRIVER'

if [ "$driver" = s3 ]; then
  media_required='STORAGE_S3_ENDPOINT STORAGE_S3_KEY STORAGE_S3_SECRET STORAGE_S3_BUCKET STORAGE_S3_PUBLIC_URL'
else
  media_required='MEDIA_PUBLIC_BASE_URL'
fi

if [ "$backup_enabled" = true ]; then
  backup_required='BACKUP_S3_ENDPOINT BACKUP_S3_KEY BACKUP_S3_SECRET BACKUP_S3_BUCKET AGE_RECIPIENT'
else
  backup_required=''
fi

required="$common_required $media_required $backup_required"
for key in $required; do eval "value=\\\"\${$key:-}\\\""; [ -n "$value" ] || fail "missing $key"; case "$value" in *REPLACE*|*replace-with*|*your-*|*example*) fail "placeholder $key";; esac; done
[ "${APP_ENV:-}" = prod ] || fail 'APP_ENV must be prod'; [ "${APP_DEBUG:-}" = 0 ] || fail 'APP_DEBUG must be 0'; [ "${DEV_AUTH_ENABLED:-}" = false ] || fail 'DEV_AUTH_ENABLED must be false'; [ "${PLACE_DISCOVERY_ENABLED:-}" = false ] || fail 'PLACE_DISCOVERY_ENABLED must be false for first deployment'
validate_origin() {
  origin_val=$1
  label=$2
  case "$origin_val" in
    https://*) ;;
    *) fail "$label must start with https://";;
  esac
  case "$origin_val" in
    *@*|*\?*|*\#*) fail "$label contains invalid characters (userinfo, query, or fragment not allowed)";;
  esac
  stripped=$(printf '%s' "$origin_val" | sed -E 's#^https://[^/]+(/?)##')
  if [ -n "$stripped" ]; then
    fail "$label must not contain a path component ($origin_val)"
  fi
}

validate_origin "$APP_PUBLIC_ORIGIN" "APP_PUBLIC_ORIGIN"

norm_public_origin=$(printf '%s' "$APP_PUBLIC_ORIGIN" | sed 's#/$##')
found_public_origin=false

old_ifs=$IFS
IFS=','
for origin_entry in $TRUSTED_AUTH_ORIGINS; do
  origin_entry_trimmed=$(printf '%s' "$origin_entry" | tr -d ' ')
  if [ -n "$origin_entry_trimmed" ]; then
    validate_origin "$origin_entry_trimmed" "TRUSTED_AUTH_ORIGINS item '$origin_entry_trimmed'"
    norm_entry=$(printf '%s' "$origin_entry_trimmed" | sed 's#/$##')
    if [ "$norm_entry" = "$norm_public_origin" ]; then
      found_public_origin=true
    fi
  fi
done
IFS=$old_ifs

if [ "$found_public_origin" = false ]; then
  fail "APP_PUBLIC_ORIGIN ($APP_PUBLIC_ORIGIN) must be included in TRUSTED_AUTH_ORIGINS ($TRUSTED_AUTH_ORIGINS)"
fi

[ "$MAP_ATTRIBUTION" = 'OpenFreeMap © OpenMapTiles Data from OpenStreetMap' ] || fail 'MAP_ATTRIBUTION must provide the required OpenFreeMap attribution'
resolved_dozzle_image=${DOZZLE_IMAGE:-amir20/dozzle:v8.11.8@sha256:d6b43130cdee36aab01a1a1fae7f83b2b8db63c1ee3b5ef61781cb947967bc9b}
resolved_gateway_image=${GATEWAY_IMAGE:-caddy:2.10.0-alpine@sha256:ae4458638da8e1a91aafffb231c5f8778e964bca650c8a8cb23a7e8ac557aa3c}
resolved_cloudflared_image=${CLOUDFLARED_IMAGE:-cloudflare/cloudflared:2026.7.0@sha256:5e49861633763e8933475477c20bae6039ed47f32c1d267a34babc347f28f0df}
for image in "$API_IMAGE" "$WEB_IMAGE" "$POSTGIS_IMAGE" "$resolved_dozzle_image" "$resolved_gateway_image" "$resolved_cloudflared_image"; do printf %s "$image" | grep -Eq '@sha256:[0-9a-f]{64}$' || fail "deployment image '$image' must use exact sha256 digest reference"; done
if [ "$backup_enabled" = true ]; then
  case "$BACKUP_S3_ENDPOINT" in https://*.r2.cloudflarestorage.com) ;; *) fail 'BACKUP_S3_ENDPOINT must be an HTTPS Cloudflare R2 endpoint';; esac
fi
if [ "$driver" = s3 ]; then
  case "$STORAGE_S3_ENDPOINT" in https://*.r2.cloudflarestorage.com) ;; *) fail 'STORAGE_S3_ENDPOINT must be an HTTPS Cloudflare R2 endpoint';; esac
  case "$STORAGE_S3_PUBLIC_URL" in https://*) ;; *) fail 'STORAGE_S3_PUBLIC_URL must start with https://';; esac
  if [ "$backup_enabled" = true ]; then
    [ "$STORAGE_S3_BUCKET" != "$BACKUP_S3_BUCKET" ] || fail 'media and backup buckets must be distinct'; [ "$STORAGE_S3_KEY" != "$BACKUP_S3_KEY" ] || fail 'media and backup credentials must be distinct'
  fi
else
  case "$MEDIA_PUBLIC_BASE_URL" in https://*) ;; *) fail 'MEDIA_PUBLIC_BASE_URL must start with https://';; esac
fi
case "$DATABASE_URL" in postgresql://*@database:5432/*'serverVersion=18'*) ;; *) fail 'DATABASE_URL must target database:5432 and PostgreSQL 18';; esac
case "$DATABASE_URL" in *'@'*'@'*|*' '*) fail 'DATABASE_URL credentials must be percent encoded';; esac
[ -r "$CLOUDFLARE_TUNNEL_TOKEN_FILE" ] || fail "CLOUDFLARE_TUNNEL_TOKEN_FILE must be readable at path: ${CLOUDFLARE_TUNNEL_TOKEN_FILE:-not set}"
[ -r "$DOZZLE_USERS_FILE" ] || fail "DOZZLE_USERS_FILE must be readable at path '${DOZZLE_USERS_FILE:-not set}'. Ensure DOZZLE_USERS_FILE=/etc/familyplaces/dozzle-users.yml is set in .env.production and the target file exists (created from infra/observability/users.yml.example)."
[ -z "${CLOUDFLARE_TUNNEL_TOKEN:-}" ] || fail 'CLOUDFLARE_TUNNEL_TOKEN must not be set directly'
[ ${#APP_SECRET} -ge 32 ] || fail 'APP_SECRET must be at least 32 characters'; [ ${#POSTGRES_PASSWORD} -ge 32 ] || fail 'POSTGRES_PASSWORD must be at least 32 characters'; [ "$APP_SECRET" != "$POSTGRES_PASSWORD" ] || fail 'application and database secrets must differ'

google_enabled=${GOOGLE_IDENTITY_ENABLED:-false}
case "$google_enabled" in
  true|false) ;;
  *) fail 'GOOGLE_IDENTITY_ENABLED must be either true or false';;
esac
if [ "$google_enabled" = true ]; then
  pub_client_id=${PUBLIC_GOOGLE_CLIENT_ID:-${GOOGLE_CLIENT_ID:-}}
  backend_client_id=${GOOGLE_CLIENT_ID:-${PUBLIC_GOOGLE_CLIENT_ID:-}}
  [ -n "$pub_client_id" ] || fail 'PUBLIC_GOOGLE_CLIENT_ID or GOOGLE_CLIENT_ID is required when GOOGLE_IDENTITY_ENABLED is true'
  case "$pub_client_id" in *REPLACE*|*replace-with*|*your-*|*example*) fail 'placeholder Google Client ID';; esac
  [ "$pub_client_id" = "$backend_client_id" ] || fail 'PUBLIC_GOOGLE_CLIENT_ID and GOOGLE_CLIENT_ID must match'
fi
echo 'production environment validation passed (values redacted)'
