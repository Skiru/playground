{
    admin off
    email {$ACME_EMAIL:admin@playground.com.pl}
}

{$GATEWAY_DOMAIN:playground.com.pl} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
        -Server
    }
    handle /healthz {
        respond "OK" 200
    }
    # `handle`, unlike `handle_path`, keeps the original /api prefix for Symfony.
    handle /api/* {
        reverse_proxy api:80
    }
    handle /media/* {
        reverse_proxy api:80
    }
    handle /admin* {
        reverse_proxy api:80
    }
    handle /bundles/* {
        reverse_proxy api:80
    }
    handle {
        reverse_proxy web:3000
    }
}

logs.{$GATEWAY_DOMAIN:playground.com.pl} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # Validate Cloudflare Access JWT Assertion token cryptographically
    # and extract verified email before allowing access to Dozzle.
    forward_auth cf-access-validator:8080 {
        uri /validate
        copy_headers Cf-Access-Authenticated-User-Email
    }

    reverse_proxy observability-logs:8080 {
        header_up -Remote-User
        header_up -Remote-Email
        header_up -Remote-Name
        header_up -Remote-Roles
    }
}
