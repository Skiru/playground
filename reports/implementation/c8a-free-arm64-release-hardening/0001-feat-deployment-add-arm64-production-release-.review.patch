diff --git a/scripts/production/backup b/scripts/production/backup
new file mode 100755
index 0000000..868c548
--- /dev/null
+++ b/scripts/production/backup
@@ -0,0 +1,18 @@
+#!/usr/bin/env zsh
+set -Eeuo pipefail
+source "${0:A:h}/lib.zsh"
+require_env; source "$ENV_FILE"
+kind=${1:-daily}; [[ $kind == <-> || $kind == *[^a-z-]* ]] && die 'invalid backup kind'
+command -v aws >/dev/null || die 'AWS CLI is required'; command -v age >/dev/null || die 'age is required'
+mkdir -p "$ROOT/.production/backups"; exec 9>"$ROOT/.production/backup.lock"; flock -n 9 || die 'backup already active'
+umask 077; stamp=$(date -u +%Y%m%dT%H%M%SZ); base="familyplaces-${kind}-${stamp}"; dump="$ROOT/.production/backups/$base.dump"; encrypted="$dump.age"
+trap 'rm -f "$dump" "$encrypted" "$encrypted.sha256"' EXIT
+compose exec -T database pg_dump -Fc -U "$POSTGRES_USER" -d "$POSTGRES_DB" > "$dump"
+pg_restore --list "$dump" >/dev/null
+age -r "$AGE_RECIPIENT" -o "$encrypted" "$dump"
+checksum=$(shasum -a 256 "$encrypted" | awk '{print $1}')
+printf '%s  %s\n' "$checksum" "${encrypted:t}" > "$encrypted.sha256"
+prefix="postgres/${kind}/${base}"
+AWS_ACCESS_KEY_ID="$BACKUP_S3_KEY" AWS_SECRET_ACCESS_KEY="$BACKUP_S3_SECRET" aws --endpoint-url "$BACKUP_S3_ENDPOINT" s3 cp "$encrypted" "s3://$BACKUP_S3_BUCKET/$prefix.age" >/dev/null
+AWS_ACCESS_KEY_ID="$BACKUP_S3_KEY" AWS_SECRET_ACCESS_KEY="$BACKUP_S3_SECRET" aws --endpoint-url "$BACKUP_S3_ENDPOINT" s3 cp "$encrypted.sha256" "s3://$BACKUP_S3_BUCKET/$prefix.age.sha256" >/dev/null
+print "backup uploaded: $prefix.age (checksum verified locally; metadata: ${RELEASE_SHA:-unknown})"
