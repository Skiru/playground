--- /dev/null
+++ b/.github/workflows/release-containers.yml
@@ -0,0 +1,51 @@
+name: Release containers
+
+on:
+  workflow_dispatch:
+  push:
+    tags: ['v*']
+
+permissions:
+  contents: read
+  packages: write
+  id-token: write
+  attestations: write
+
+jobs:
+  release:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 75
+    steps:
+      - uses: actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8 # v5.0.0
+        with: {fetch-depth: 0}
+      - name: Verify trusted release source
+        run: |
+          git fetch origin main --depth=1
+          git merge-base --is-ancestor "$GITHUB_SHA" origin/main
+      - uses: docker/setup-qemu-action@c7c53464625b32c7a7e944ae62b3e17d2b600130 # v3
+      - uses: docker/setup-buildx-action@e468171a9de216ec08956ac3ada2f0791b6bd435 # v3.11.1
+      - uses: docker/login-action@184bdaa0721073962dff0199f1fb9940f07167d1 # v3.5.0
+        with: {registry: ghcr.io, username: ${{ github.actor }}, password: ${{ secrets.GITHUB_TOKEN }}
+      - name: Quality gate and amd64 runtime smoke
+        run: ./scripts/check && ./scripts/test
+      - name: Build and publish multi-platform images
+        env:
+          SHA: ${{ github.sha }}
+          VERSION: ${{ github.ref_name }}
+          CREATED: ${{ github.event.repository.updated_at }}
+        run: |
+          for item in 'api infra/docker/api.Dockerfile family-places-api' 'web infra/docker/web.Dockerfile family-places-web' 'postgis infra/docker/postgis.Dockerfile family-places-postgis'; do
+            set -- $item
+            docker buildx build --platform linux/amd64,linux/arm64 --push --provenance=true --sbom=true --file "$2" --tag "ghcr.io/skiru/$3:sha-$SHA" --tag "ghcr.io/skiru/$3:$VERSION" --build-arg OCI_REVISION="$SHA" --build-arg OCI_VERSION="$VERSION" --build-arg OCI_CREATED="$CREATED" .
+            docker buildx imagetools inspect "ghcr.io/skiru/$3:sha-$SHA"
+          done
+      - name: Release manifest
+        run: |
+          mkdir -p release-manifest
+          git rev-parse HEAD > release-manifest/source-commit.txt
+          git rev-parse HEAD^{tree} > release-manifest/source-tree.txt
+          docker buildx imagetools inspect ghcr.io/skiru/family-places-api:sha-${{ github.sha }} > release-manifest/api-manifest.txt
+          docker buildx imagetools inspect ghcr.io/skiru/family-places-web:sha-${{ github.sha }} > release-manifest/web-manifest.txt
+          docker buildx imagetools inspect ghcr.io/skiru/family-places-postgis:sha-${{ github.sha }} > release-manifest/postgis-manifest.txt
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with: {name: release-manifest, path: release-manifest}
