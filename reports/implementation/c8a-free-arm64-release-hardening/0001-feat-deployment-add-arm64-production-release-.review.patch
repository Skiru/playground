+#!/bin/sh
+set -eu
+
+env_file=${1:-.env.production}
+[ -f "$env_file" ] || { echo "missing production environment file" >&2; exit 1; }
+set -a
+. "$env_file"
+set +a
+fail() { echo "production environment validation failed: $1" >&2; exit 1; }
+required='APP_SECRET POSTGRES_PASSWORD DATABASE_URL PUBLIC_GOOGLE_CLIENT_ID STORAGE_S3_ENDPOINT STORAGE_S3_KEY STORAGE_S3_SECRET STORAGE_S3_BUCKET STORAGE_S3_PUBLIC_URL MAP_ATTRIBUTION CLOUDFLARE_TUNNEL_TOKEN API_IMAGE WEB_IMAGE POSTGIS_IMAGE'
+for key in $required; do eval "value=\${$key:-}"; [ -n "$value" ] || fail "missing $key"; case "$value" in *REPLACE*|*replace-with*|*your-*|*example*) fail "placeholder $key";; esac; done
+[ "${APP_ENV:-}" = prod ] || fail 'APP_ENV must be prod'
+[ "${APP_DEBUG:-}" = 0 ] || fail 'APP_DEBUG must be 0'
+[ "${DEV_AUTH_ENABLED:-}" = false ] || fail 'DEV_AUTH_ENABLED must be false'
+[ "${PLACE_DISCOVERY_ENABLED:-}" = false ] || fail 'PLACE_DISCOVERY_ENABLED must be false for first deployment'
+[ "${STORAGE_DRIVER:-}" = s3 ] || [ "${ALLOW_LOCAL_STORAGE_EMERGENCY:-false}" = true ] || fail 'production storage must be s3'
