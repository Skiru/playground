APP_ENV=prod
APP_DEBUG=0
APP_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
POSTGRES_DB=family_places
POSTGRES_USER=family_places
POSTGRES_PASSWORD=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
DATABASE_URL="postgresql://family_places:REPLACE_PASSWORD@database:5432/family_places?serverVersion=18&charset=utf8"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
GOOGLE_IDENTITY_ENABLED=true
PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
APP_PUBLIC_ORIGIN=https://playground.com.pl
TRUSTED_AUTH_ORIGINS=https://playground.com.pl,https://www.playground.com.pl
GATEWAY_DOMAIN=playground.com.pl
ACME_EMAIL=admin@playground.com.pl
DEV_AUTH_ENABLED=false
PLACE_DISCOVERY_ENABLED=false

# --- MODE 1: FIRST DEPLOY / MINIMAL (No R2 / No S3 backups) ---
STORAGE_DRIVER=local
MEDIA_PUBLIC_BASE_URL=https://playground.com.pl/media
BACKUP_ENABLED=false

# --- MODE 2: FULL PRODUCTION (Cloudflare R2 media & backups) ---
# Uncomment and set below for full production:
# STORAGE_DRIVER=s3
# STORAGE_S3_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
# STORAGE_S3_KEY=REPLACE_WITH_R2_ACCESS_KEY
# STORAGE_S3_SECRET=REPLACE_WITH_R2_SECRET
# STORAGE_S3_BUCKET=familyplaces-media-prod
# STORAGE_S3_REGION=auto
# STORAGE_S3_PUBLIC_URL=https://media.playground.com.pl
# BACKUP_ENABLED=true
# BACKUP_S3_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=familyplaces-backups-prod
# BACKUP_S3_KEY=REPLACE_WITH_BACKUP_R2_ACCESS_KEY
# BACKUP_S3_SECRET=REPLACE_WITH_BACKUP_R2_SECRET
# BACKUP_S3_REGION=auto
# AGE_RECIPIENT=age1REPLACE_WITH_OFFLINE_BACKUP_RECIPIENT

MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_PROVIDER_NAME=OpenFreeMap
MAP_ATTRIBUTION="OpenFreeMap © OpenMapTiles Data from OpenStreetMap"

# An absolute, mode 0400 file containing the tunnel token. Never put its value here.
CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/familyplaces/cloudflared-token

# An absolute, mode 0600 file containing Dozzle authenticated user hashes (from infra/observability/users.yml.example).
DOZZLE_USERS_FILE=/etc/familyplaces/dozzle-users.yml

# NOTE: Image digests (API_IMAGE, WEB_IMAGE, POSTGIS_IMAGE) and release tags (RELEASE_SHA, RELEASE_VERSION)
# are automatically resolved by `./scripts/production/deploy --release <release>`.
# Do NOT manually copy digests here.
