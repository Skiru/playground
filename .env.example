APP_ENV=dev
APP_SECRET=replace-with-a-random-local-value
POSTGRES_DB=family_places
POSTGRES_USER=family_places
POSTGRES_PASSWORD=replace-with-a-random-local-value
DATABASE_URL=postgresql://family_places:replace-with-a-random-local-value@database:5432/family_places?serverVersion=18&charset=utf8
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
MAP_ATTRIBUTION=MapLibre demonstration tiles
MAP_PROVIDER_NAME=MapLibre Demo Tiles
API_BASE_URL=http://api
GOOGLE_IDENTITY_ENABLED=false
PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here
DEV_AUTH_ENABLED=true

# Container Images Configuration
API_IMAGE=family-places-api:local
WEB_IMAGE=family-places-web:local
POSTGIS_IMAGE=postgis/postgis:18-3.6@sha256:c893f6f2652d11e13f50f8623045b3523991b41d038b4d213dc040f42641f0d7
CF_ACCESS_VALIDATOR_IMAGE=family-places-cf-access-validator:local
CLOUDFLARE_ACCESS_ISSUER=https://playground.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=dummy_aud_value
CLOUDFLARE_ACCESS_TEST_MODE=false
DOZZLE_IMAGE=amir20/dozzle:v8.11.8@sha256:d6b43130cdee36aab01a1a1fae7f83b2b8db63c1ee3b5ef61781cb947967bc9b
DOZZLE_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.1.1@sha256:6c22b9545adc95258af9deffdde6c0ce0a0a70716771e5a4e02d24d1b6e0dda1
DOZZLE_AUTH_PROVIDER=forward-proxy
DOZZLE_AUTH_HEADER_USER=Cf-Access-Authenticated-User-Email
DOZZLE_AUTH_HEADER_EMAIL=Cf-Access-Authenticated-User-Email
DOZZLE_AUTH_HEADER_NAME=Cf-Access-Authenticated-User-Email

# Media Storage Configuration
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/familyplaces-media
# In production, MEDIA_PUBLIC_BASE_URL must be a public URL accessible from the user's browser (e.g., https://yourdomain.com/media)
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media
